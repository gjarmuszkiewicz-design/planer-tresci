# Na Railway ustaw te zmienne w zakładce Variables. DATABASE_URL doda się sama po podłączeniu PostgreSQL.

# losowy, długi ciąg znaków – np. wynik: openssl rand -hex 32
SECRET_KEY=
# 1 na produkcji (HTTPS), 0 lokalnie
COOKIE_SECURE=1

# pierwsze konto administratora – tworzone przy pierwszym starcie, gdy w bazie nie ma jeszcze żadnego konta
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# opcjonalnie: limit wielkości wgrywanej grafiki w MB (domyślnie 15)
# MAX_UPLOAD_MB=15

# lokalnie bez PostgreSQL aplikacja użyje pliku planer.db (SQLite)
# DATABASE_URL=postgresql://...
